{
  "name": "lo-fly-beats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run data:validate && npm run build",
    "data:download": "uv run --project scripts/data python scripts/data/download_sources.py",
    "data:extract": "uv run --project scripts/data python scripts/data/extract_circuit.py",
    "data:verify": "uv run --project scripts/data python scripts/data/verify_circuit.py",
    "data:validate": "vitest run --project unit tests/data"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
